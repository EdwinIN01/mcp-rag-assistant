# LLM API（兼容 OpenAI 接口，支持 Qwen/DeepSeek/OpenAI 等）
# 不配置也能跑：Web UI 会降级为只展示检索片段
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=qwen-plus

# Embedding（API 方式，与本地 Embedding 二选一）
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-your-api-key-here
EMBEDDING_MODEL=text-embedding-v3

# 本地 Embedding（推荐，避免联网）
USE_LOCAL_EMBEDDING=true
# 默认用本地缓存的 bge-base-zh-v1.5
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5

# HuggingFace 离线模式（避免请求 HuggingFace 官网）
HF_HUB_OFFLINE=1

# 重排模型（可选，本地没有则自动跳过重排）
RERANKER_MODEL=BAAI/bge-reranker-base

# 向量库
CHROMA_PERSIST_DIR=./data/chroma

# 文档注册表（SQLite，记录文档状态机：pending/parsing/available/duplicate/failed）
REGISTRY_DB_PATH=./data/registry.db

# 文档目录
DOCS_DIR=./data/docs

# API 服务（FastAPI）
API_HOST=0.0.0.0
API_PORT=8000
# 启动时预热模型（首次加载约 15 秒，生产建议开启，开发可关闭提速）
API_PRELOAD_MODELS=true

# 可观测性：结构化日志（console 带颜色开发用 / json 生产采集用）
LOG_LEVEL=INFO
LOG_FORMAT=console

# Langfuse 追踪（可选，不配置则自动降级关闭，零开销）
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_HOST=https://cloud.langfuse.com

# RAGAS 评估质量门禁阈值（可选覆盖；任一指标低于阈值则 python -m evaluation 退出码 1）
# 默认值基于 25 题测试集实测水位校准，可按业务要求收紧
# EVAL_THRESHOLDS={"faithfulness": 0.60, "answer_relevancy": 0.65, "context_precision": 0.60, "context_recall": 0.60, "rejection_rate": 0.80}

# 鉴权（阶段 5）：false 时所有接口免认证（仅限本地开发）
AUTH_ENABLED=true
# JWT 签名密钥：生产必配（openssl rand -hex 32）；不配置则每次重启后 token 失效
JWT_SECRET=
JWT_EXPIRE_MINUTES=720